import { logger, fetchWithTimeout, shouldFallback, generateId } from './utils.js';
import { recordRequest } from './tracker.js';
import { convertRequest, convertResponse, buildHeaders } from './provider.js';
import { streamProviderToClient, writeSSE, writeDone } from './stream.js';

/**
 * Build the fallback chain based on activeModel and provider order.
 * Order: activeModel first → same-provider other models → other providers' models (in provider order)
 */
function buildFallbackChain(config) {
  const { flatModels, activeModel, providers } = config;
  if (!activeModel || flatModels.length === 0) return flatModels;

  const active = flatModels.find(m => m.key === activeModel);
  if (!active) return flatModels;

  const chain = [active];

  // Same provider's other models (in their original order)
  for (const m of flatModels) {
    if (m.key !== activeModel && m.providerName === active.providerName) {
      chain.push(m);
    }
  }

  // Other providers' models (in provider order)
  for (const p of providers) {
    if (p.name === active.providerName) continue;
    for (const m of flatModels) {
      if (m.providerName === p.name) {
        chain.push(m);
      }
    }
  }

  return chain;
}

/**
 * Execute a single request to a model entry.
 * Returns { success: true, response, fetchResponse } or { success: false, error, statusCode }
 */
async function tryModel(entry, originalBody, config, { streaming = false } = {}) {
  const { url, body } = convertRequest(entry, originalBody);
  const headers = buildHeaders(entry);
  const startTime = Date.now();

  const fetchOptions = {
    method: 'POST',
    headers,
    body: JSON.stringify(body),
  };

  try {
    const res = await fetchWithTimeout(url, fetchOptions, config.timeout);
    const elapsed = Date.now() - startTime;

    if (!res.ok) {
      const errorText = await res.text().catch(() => 'Unknown error');
      logger.warn(
        `[${entry.key}] HTTP ${res.status} (${elapsed}ms): ${errorText.slice(0, 200)}`
      );
      return {
        success: false,
        statusCode: res.status,
        error: new Error(`${entry.key}: HTTP ${res.status} - ${errorText.slice(0, 200)}`),
        elapsed,
        shouldFallback: shouldFallback(res.status),
      };
    }

    if (streaming) {
      logger.info(`[${entry.key}] Streaming started (${elapsed}ms)`);
      return { success: true, fetchResponse: res, elapsed };
    }

    const data = await res.json();
    const converted = convertResponse(entry, data);
    const tokensIn = converted.usage?.prompt_tokens || data.usage?.prompt_tokens || data.usage?.input_tokens || 0;
    const tokensOut = converted.usage?.completion_tokens || data.usage?.completion_tokens || data.usage?.output_tokens || 0;
    logger.info(`[${entry.key}] Success (${elapsed}ms, tokens: ${tokensIn}+${tokensOut})`);
    return { success: true, response: converted, elapsed, tokensIn, tokensOut };
  } catch (err) {
    const elapsed = Date.now() - startTime;

    if (err.code === 'ETIMEDOUT') {
      logger.warn(`[${entry.key}] Timeout after ${elapsed}ms`);
      return { success: false, error: err, elapsed, shouldFallback: true };
    }

    logger.warn(`[${entry.key}] Error (${elapsed}ms): ${err.message}`);
    return { success: false, error: err, elapsed, shouldFallback: true };
  }
}

/**
 * Main orchestrator entry point.
 * Handles the full flow: activeModel retry → fallback chain.
 */
export async function handleRequest(req, res, config) {
  const { body, streaming } = req;
  const chain = buildFallbackChain(config);

  if (chain.length === 0) {
    sendError(res, 502, 'No models configured');
    return;
  }

  const primary = chain[0];
  const fallbacks = chain.slice(1);

  // === Phase 1: Active model with retries ===
  logger.info(`[orchestrator] Phase 1: activeModel=${primary.key}, maxRetries=${config.maxRetries}`);

  for (let attempt = 1; attempt <= config.maxRetries; attempt++) {
    logger.info(`[orchestrator] Primary attempt ${attempt}/${config.maxRetries}`);
    const result = await tryModel(primary, body, config, { streaming });

    if (result.success) {
      if (streaming) {
        logger.info(`[orchestrator] Primary succeeded, streaming response`);
        const streamResult = await streamProviderToClient(primary, result.fetchResponse, res);
        recordRequest({ provider: primary.key, phase: 'primary', success: streamResult.success, elapsed: result.elapsed, statusCode: streamResult.success ? 200 : 500, tokensIn: streamResult.tokensIn || 0, tokensOut: streamResult.tokensOut || 0, error: streamResult.error?.message });
        if (streamResult.success) return;
        logger.warn(`[orchestrator] Primary stream failed mid-way, trying fallback`);
        if (!res.writableEnded) { res.end(); return; }
      } else {
        recordRequest({ provider: primary.key, phase: 'primary', success: true, elapsed: result.elapsed, statusCode: 200, tokensIn: result.tokensIn || 0, tokensOut: result.tokensOut || 0 });
        sendJSON(res, result.response);
        return;
      }
    }

    recordRequest({ provider: primary.key, phase: 'primary', success: false, elapsed: result.elapsed, statusCode: result.statusCode, error: result.error?.message });

    if (result.shouldFallback === false) {
      logger.error(`[orchestrator] Primary returned non-retryable error (${result.statusCode})`);
      sendError(res, result.statusCode || 500, result.error.message);
      return;
    }

    if (attempt < config.maxRetries) {
      logger.info(`[orchestrator] Primary attempt ${attempt} failed, retrying...`);
    }
  }

  // === Phase 2: Fallback chain ===
  if (fallbacks.length === 0) {
    logger.error('[orchestrator] All retries exhausted, no fallback models');
    sendError(res, 502, 'All primary model retries exhausted, no fallback models');
    return;
  }

  logger.info(
    `[orchestrator] Phase 2: Parallel fallback with ${fallbacks.length} models: ${fallbacks.map(m => m.key).join(', ')}`
  );

  if (streaming) {
    await handleParallelFallbackStreaming(fallbacks, body, res, config);
  } else {
    await handleParallelFallbackComplete(fallbacks, body, res, config);
  }
}

/**
 * Parallel fallback for non-streaming requests
 */
async function handleParallelFallbackComplete(fallbacks, body, res, config) {
  return new Promise((resolve) => {
    let settled = false;
    const abortControllers = fallbacks.map(() => new AbortController());

    const promises = fallbacks.map((entry, i) => {
      const { url, body: convertedBody } = convertRequest(entry, body);
      const headers = buildHeaders(entry);
      const startTime = Date.now();

      return fetch(url, {
        method: 'POST',
        headers,
        body: JSON.stringify(convertedBody),
        signal: abortControllers[i].signal,
      })
        .then(async (fetchRes) => {
          const elapsed = Date.now() - startTime;
          if (!fetchRes.ok) {
            const errorText = await fetchRes.text().catch(() => '');
            throw new Error(`${entry.key}: HTTP ${fetchRes.status} - ${errorText.slice(0, 200)}`);
          }
          const data = await fetchRes.json();
          return { entry, data, elapsed };
        })
        .then(({ entry, data, elapsed }) => {
          if (settled) return;
          settled = true;

          abortControllers.forEach((ac, j) => { if (j !== i) ac.abort(); });

          const converted = convertResponse(entry, data);
          logger.info(`[${entry.key}] Fallback succeeded (${elapsed}ms)`);
          recordRequest({ provider: entry.key, phase: 'fallback', success: true, elapsed, statusCode: 200 });
          sendJSON(res, converted);
          resolve();
        })
        .catch((err) => {
          if (err.name === 'AbortError') return;
          logger.warn(`[${entry.key}] Fallback failed: ${err.message}`);
          recordRequest({ provider: entry.key, phase: 'fallback', success: false, elapsed: Date.now() - startTime, error: err.message });
        });
    });

    const timeoutId = setTimeout(() => {
      if (!settled) {
        settled = true;
        abortControllers.forEach(ac => ac.abort());
        logger.error('[orchestrator] All fallback models timed out');
        sendError(res, 504, 'All fallback models timed out');
        resolve();
      }
    }, config.parallelTimeout);

    Promise.allSettled(promises).then(() => {
      clearTimeout(timeoutId);
      if (!settled) {
        settled = true;
        logger.error('[orchestrator] All fallback models failed');
        sendError(res, 502, 'All fallback models failed');
        resolve();
      }
    });
  });
}

/**
 * Parallel fallback for streaming requests
 */
async function handleParallelFallbackStreaming(fallbacks, body, res, config) {
  return new Promise((resolve) => {
    let settled = false;
    const abortControllers = fallbacks.map(() => new AbortController());

    const promises = fallbacks.map((entry, i) => {
      const { url, body: convertedBody } = convertRequest(entry, body);
      const headers = buildHeaders(entry);
      const startTime = Date.now();

      return fetch(url, {
        method: 'POST',
        headers: { ...headers, Accept: 'text/event-stream' },
        body: JSON.stringify(convertedBody),
        signal: abortControllers[i].signal,
      })
        .then(async (fetchRes) => {
          const elapsed = Date.now() - startTime;
          if (!fetchRes.ok) {
            const errorText = await fetchRes.text().catch(() => '');
            throw new Error(`${entry.key}: HTTP ${fetchRes.status} - ${errorText.slice(0, 200)}`);
          }
          return { entry, fetchRes, elapsed };
        })
        .then(async ({ entry, fetchRes, elapsed }) => {
          if (settled) return;
          settled = true;

          abortControllers.forEach((ac, j) => { if (j !== i) ac.abort(); });

          logger.info(`[${entry.key}] Fallback streaming started (${elapsed}ms)`);
          const streamResult = await streamProviderToClient(entry, fetchRes, res);
          recordRequest({ provider: entry.key, phase: 'fallback-stream', success: streamResult.success, elapsed, statusCode: streamResult.success ? 200 : 500, tokensIn: streamResult.tokensIn || 0, tokensOut: streamResult.tokensOut || 0, error: streamResult.error?.message });
          if (!res.writableEnded) res.end();
          resolve();
        })
        .catch((err) => {
          if (err.name === 'AbortError') return;
          logger.warn(`[${entry.key}] Fallback streaming failed: ${err.message}`);
        });
    });

    const timeoutId = setTimeout(() => {
      if (!settled) {
        settled = true;
        abortControllers.forEach(ac => ac.abort());
        if (!res.writableEnded) sendError(res, 504, 'All fallback models timed out');
        resolve();
      }
    }, config.parallelTimeout);

    Promise.allSettled(promises).then(() => {
      clearTimeout(timeoutId);
      if (!settled) {
        settled = true;
        if (!res.writableEnded) sendError(res, 502, 'All fallback models failed');
        resolve();
      }
    });
  });
}

function sendJSON(res, data) {
  if (res.writableEnded) return;
  res.writeHead(200, { 'Content-Type': 'application/json' });
  res.end(JSON.stringify(data));
}

function sendError(res, statusCode, message) {
  if (res.writableEnded) return;
  res.writeHead(statusCode, { 'Content-Type': 'application/json' });
  res.end(
    JSON.stringify({
      error: {
        message,
        type: statusCode === 429 ? 'rate_limit_error' : 'api_error',
        code: statusCode.toString(),
      },
    })
  );
}
