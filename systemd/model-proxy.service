[Unit]
Description=Model Proxy - OpenAI-compatible model proxy with fallback
After=network.target

[Service]
Type=simple
ExecStart=/path/to/node /path/to/model-proxy/src/server.js
WorkingDirectory=/path/to/model-proxy
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
